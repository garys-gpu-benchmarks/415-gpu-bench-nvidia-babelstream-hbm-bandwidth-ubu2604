    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "check,device_id,array_size,dtype,block_size,status,bandwidth_gb_s_copy,bandwidth_gb_s_mul,bandwidth_gb_s_add,bandwidth_gb_s_triad,bandwidth_gb_s_dot\nCopy,0,16777216,fp64,256,ok,4200,4100,4300,4250,3000"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --dtype FP64 --block-size 256 --array-size 1048576 --kernels Copy,Mul,Add,Triad,Dot --warmup-iters 1 --num-iterations 2 --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --dtype FP64 --block-size 256 --array-size 268435456 --kernels Copy,Mul,Add,Triad,Dot --warmup-iters 2 --num-iterations 30000 --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
